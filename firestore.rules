rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'aF0G4M2NnBZacEJ7mt2SilxEMmu2';
    }
    // Solo la gerencia puede consultar y administrar solicitudes por ahora.
    // La recepción pública desde QR requiere protección antiabuso antes de habilitarla.
    match /solicitudes/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    // Perfiles administrados exclusivamente por gerencia.
    match /configuracion/mozos {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
