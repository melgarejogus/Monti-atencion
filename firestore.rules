rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'aF0G4M2NnBZacEJ7mt2SilxEMmu2';
    }
    // Solo la gerencia puede consultar y administrar solicitudes por ahora.
    // La recepción pública desde QR requiere protección antiabuso antes de habilitarla.
    match /solicitudes/{id} {
      allow read, create, update, delete: if isAdmin();
    }
    // Perfiles administrados exclusivamente por gerencia.
    function isBar() {
      return request.auth != null && request.auth.uid == 'PUoMTmxvPUUQhaPcfChBlVloGOp1';
    }
    match /llamados/{id} {
      allow read: if isAdmin() || isBar();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['mesa','tipo','detalle','estado','creadoEn','origen'])
        && request.resource.data.mesa is int
        && request.resource.data.mesa >= 1 && request.resource.data.mesa <= 999
        && request.resource.data.tipo == 'mozo'
        && request.resource.data.detalle is string
        && request.resource.data.detalle.size() <= 250
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.origen == 'prueba-gerencia'
        && request.resource.data.creadoEn == request.time;
      allow update: if (isAdmin() || isBar())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && ((resource.data.estado == 'Pendiente' && request.resource.data.estado == 'En atención')
        || (resource.data.estado == 'En atención' && request.resource.data.estado == 'Resuelto'));
      allow delete: if isAdmin();
    }
    match /configuracion/mozos {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
